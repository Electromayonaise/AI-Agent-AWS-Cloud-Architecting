# ── Groq ───────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# ── AWS Credentials (copy from AWS Academy Learner Lab) ────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_SESSION_TOKEN=your_session_token

# ── S3 ─────────────────────────────────────────────────────────
# Bucket where original images are uploaded
S3_BUCKET_SOURCE=ai-image-lab-source
# Bucket where processed images are saved (can be the same bucket)
S3_BUCKET_DEST=ai-image-lab-source

# ── Lambda ─────────────────────────────────────────────────────
LAMBDA_FUNCTION_NAME=ImageResizeAgent

# ── API Gateway (optional) ─────────────────────────────────────
# If set, the tool calls Lambda through this URL.
# If empty, the tool calls Lambda directly via boto3.
# AWS Academy blocks API Gateway creation, so leave this blank.
API_GATEWAY_URL=

# ── Model settings ─────────────────────────────────────────────
MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0
